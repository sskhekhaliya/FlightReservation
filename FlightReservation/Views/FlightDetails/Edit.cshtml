@model FlightReservation.Models.FlightDetail

@{
    ViewData["Title"] = "Edit Flight";
}

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><span class="material-symbols-outlined" style="vertical-align: middle;">edit</span> Edit Flight</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="FlightID" />
                    
                    <div class="form-group mb-3">
                        <label class="control-label fw-bold">Flight ID</label>
                        <input class="form-control" value="@Model.FlightID" disabled />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label fw-bold">Airline Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Air India" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Logo" class="control-label fw-bold">Logo URL</label>
                        <input asp-for="Logo" class="form-control" placeholder="Paste an image URL here..." />
                        <span asp-validation-for="Logo" class="text-danger"></span>
                    </div>

                    <div class="text-center text-muted mb-3">
                        <small><strong>&mdash; OR &mdash;</strong></small>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="LogoFile" class="control-label fw-bold"></label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="LogoFile" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="mt-4 text-center">
            <a asp-action="Index" class="text-decoration-none text-muted">
                <span class="material-symbols-outlined" style="vertical-align: middle; font-size: 1.2rem;">arrow_back</span> Back to Flight List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

