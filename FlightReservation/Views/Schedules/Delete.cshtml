@model FlightReservation.Models.Schedule

@{ ViewData["Title"] = "Delete Schedule"; }

<div class="row mt-4">
    <div class="col-md-8 offset-md-2">
        <div class="alert alert-danger shadow-sm border-0" role="alert">
            <h4 class="alert-heading fw-bold"><span class="material-symbols-outlined align-middle">warning</span> Are you sure?</h4>
            <p>You are about to permanently delete this schedule. This action cannot be undone.</p>
        </div>
        <div class="card shadow-sm border-0 border-danger">
            <div class="card-body p-4">
                <div class="row mb-3 text-center">
                    <div class="col">
                        <h4 class="fw-bold">@(Model.From?.Split('-').FirstOrDefault()?.Trim())</h4>
                        <small>@Model.BoardingTime</small>
                    </div>
                    <div class="col-2 d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined text-danger" style="font-size: 2rem;">arrow_forward</span>
                    </div>
                    <div class="col">
                        <h4 class="fw-bold">@(Model.To?.Split('-').FirstOrDefault()?.Trim())</h4>
                        <small>@Model.DepartureTime</small>
                    </div>
                </div>
                <div class="text-center">
                    <p class="mb-0 text-muted">Flight: <strong>@Model.FlightDetail.FlightID</strong></p>
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary"><span class="material-symbols-outlined align-middle" style="font-size:18px;">arrow_back</span> Cancel</a>
                <form asp-action="Delete" class="m-0">
                    <input type="hidden" asp-for="ScheduleID" />
                    <button type="submit" class="btn btn-danger"><span class="material-symbols-outlined align-middle" style="font-size:18px;">delete</span> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

